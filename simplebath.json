{
    "$schema": "https://vega.github.io/schema/vega/v6.json",
    "description": "Simplified Natural Earth bathymetry from a single TopoJSON file.",
    "width": 960,
    "height": 540,
    "autosize": "none",
    "background": "white",

    "title": {
        "text": "Natural Earth Bathymetry",
        "subtitle": "Single simplified TopoJSON file",
        "anchor": "start",
        "fontSize": 18,
        "subtitleFontSize": 12
    },

    "signals": [
        {
            "name": "projectionType",
            "value": "naturalEarth1",
            "bind": {
                "input": "select",
                "options": [
                    "naturalEarth1",
                    "equalEarth",
                    "mercator",
                    "orthographic"
                ]
            }
        },
        {
            "name": "mapScale",
            "value": 170,
            "bind": { "input": "range", "min": 100, "max": 450, "step": 1 }
        },
        {
            "name": "strokeWidth",
            "value": 0.2,
            "bind": { "input": "range", "min": 0, "max": 1.5, "step": 0.05 }
        }
    ],

    "projections": [
        {
            "name": "projection",
            "type": { "signal": "projectionType" },
            "scale": { "signal": "mapScale" },
            "translate": [{ "signal": "width / 2" }, { "signal": "height / 2" }]
        }
    ],

    "data": [
        {
            "name": "sphere",
            "values": [{ "type": "Sphere" }]
        },
        {
            "name": "bathymetry",
            "url": "./bathymetry.topo.json",
            "format": {
                "type": "topojson",
                "feature": "bathymetry"
            },
            "transform": [
                {
                    "type": "formula",
                    "expr": "datum.properties.depth_m",
                    "as": "depth_m"
                },
                {
                    "type": "formula",
                    "expr": "datum.depth_m === 0 ? '0 m' : '-' + datum.depth_m + ' m'",
                    "as": "depth_label"
                },
                {
                    "type": "collect",
                    "sort": { "field": "depth_m", "order": "ascending" }
                }
            ]
        }
    ],

    "scales": [
        {
            "name": "depthColor",
            "type": "ordinal",
            "domain": [0, 200, 1000, 2000, 4000, 6000, 10000],
            "range": [
                "#deebf7",
                "#c6dbef",
                "#9ecae1",
                "#6baed6",
                "#4292c6",
                "#2171b5",
                "#084594"
            ]
        }
    ],

    "legends": [
        {
            "fill": "depthColor",
            "title": "Depth band",
            "orient": "bottom-right",
            "labelExpr": "datum.label === 0 ? '0 m' : '-' + datum.label + ' m'"
        }
    ],

    "marks": [
        {
            "type": "shape",
            "from": { "data": "sphere" },
            "transform": [{ "type": "geoshape", "projection": "projection" }],
            "encode": {
                "update": {
                    "fill": { "value": "#f7fbff" },
                    "stroke": { "value": null }
                }
            }
        },
        {
            "type": "shape",
            "from": { "data": "bathymetry" },
            "transform": [{ "type": "geoshape", "projection": "projection" }],
            "encode": {
                "enter": {
                    "stroke": { "value": "#ffffff" },
                    "cursor": { "value": "pointer" }
                },
                "update": {
                    "fill": { "scale": "depthColor", "field": "depth_m" },
                    "strokeWidth": { "signal": "strokeWidth" },
                    "tooltip": {
                        "signal": "{'Depth band': datum.depth_label}"
                    }
                },
                "hover": {
                    "stroke": { "value": "#2b4c66" },
                    "strokeWidth": { "value": 0.6 }
                }
            }
        }
    ]
}
